# 이 파일을 .env.local 로 복사한 뒤 값을 채운다 (.env.local 은 git에 올라가지 않음)
# 이 파일(.env.example)에는 절대 실제 값을 적지 말 것 — GitHub에 공개된다
# 값 위치: Supabase 대시보드 > Project Settings > API (API Keys)

# 1. Supabase URL (예: https://abcdefghijkl.supabase.co, 끝에 /rest/v1/ 붙이지 말 것)
VITE_SUPABASE_URL=

# 2. anon 키 (eyJ... 또는 sb_publishable_...)
VITE_SUPABASE_ANON_KEY=

# 3. service_role 키 (eyJ... 또는 sb_secret_...)
#    VITE_ 를 붙이지 말 것 (붙이면 웹사이트 코드에 노출됨). Vercel 환경변수에도 넣지 말 것
SUPABASE_SERVICE_ROLE_KEY=
