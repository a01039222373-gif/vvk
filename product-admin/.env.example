# 내 PC에서 실행할 때: 이 파일을 .env.local 로 복사한 뒤 값을 채운다 (.env.local 은 git에 올라가지 않음)
# Vercel에 배포할 때: 1, 2번만 Vercel 프로젝트 Settings > Environment Variables 에 넣는다
# 값 위치: Supabase 대시보드 > Project Settings > API (API Keys)

# 1. Supabase URL (예: https://abcdefghijkl.supabase.co)
VITE_SUPABASE_URL=

# 2. anon 키 (eyJ... 또는 sb_publishable_...) — 웹사이트가 사용. 공개돼도 되는 키
VITE_SUPABASE_ANON_KEY=

# 3. service_role 키 — 웹사이트는 사용하지 않음, 보관용
#    VITE_ 를 붙이지 말 것 (붙이면 웹사이트 코드에 노출됨). Vercel 환경변수에도 넣지 말 것
SUPABASE_SERVICE_ROLE_KEY=
